# Copy to .env and edit:  cp .env.example .env
#
# NIC plugged into the switch's SPAN / mirror port (find it with: ip -br link).
# It must NOT be the NIC you SSH in through.
LIVE_IFACE=enp2s0

# Optional BPF filter, e.g. ignore the box's own management traffic:
# ZEEK_BPF=not host 192.168.1.50
ZEEK_BPF=

# Days to keep rotated Zeek logs on disk
LOG_RETENTION_DAYS=7

# Wipe old Zeek logs whenever the zeek container starts
CLEAN_LOGS_ON_START=true

# Port for the web UI
PROXY_PORT=8080
